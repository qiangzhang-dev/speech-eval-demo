        "日志",
        "保存",
        "查看",
        "下载"
      ],
      "required_evidence": [
        "功能测试",
        "异常测试",
        "运行日志"
      ],
      "blocking": true,
      "readme_condition": "异常隔离、日志、保存、查看和下载全部可用"
