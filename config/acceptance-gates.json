      "blocking": true,
      "readme_condition": "14字段存在率100%，缺失事实正确标记"
    },
    {
      "id": "G05",
      "name": "指标",
      "type": "hybrid",
      "measure": "automatic_metric_reproducibility",
      "operator": "all",
      "expected": {
        "automatic_metric_count_minimum": 1,
        "gold_standard_test_pass_rate": 1.0,
        "repeated_runs_identical": true
