      "required_evidence": [
        "冻结清单覆盖统计"
      ],
      "blocking": true,
      "readme_condition": "场景不少于3、子场景不少于2、能力链路不少于2"
    },
    {
      "id": "G04",
      "name": "字段",
      "type": "automatic",
      "measure": "result_field_and_missing_fact_integrity",
      "operator": "all",
