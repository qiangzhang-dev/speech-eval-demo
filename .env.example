# The default profile is deterministic and does not call a remote service.
SPEECH_EVAL_ENV=development
SPEECH_EVAL_HOST=127.0.0.1
SPEECH_EVAL_PORT=8000
SPEECH_EVAL_LOG_LEVEL=INFO

# Paths are resolved from the project root.
SPEECH_EVAL_DATA_DIR=./data
SPEECH_EVAL_OUTPUT_DIR=./artifacts
SPEECH_EVAL_LOG_DIR=./logs
SPEECH_EVAL_PLAN=./config/evaluation-plan.json
SPEECH_EVAL_THRESHOLDS=./config/thresholds.json
SPEECH_EVAL_GATES=./config/acceptance-gates.json
SPEECH_EVAL_RESULT_SCHEMA=./schemas/evaluation-result.schema.json
SPEECH_EVAL_PROMPT_MANIFEST=./config/prompts/prompt-manifest.json

# Safety/resource limits.
SPEECH_EVAL_MAX_UPLOAD_MB=100
SPEECH_EVAL_ALLOW_REMOTE=false

# Optional remote analyzer. Keep empty for offline/rule-based operation.
SPEECH_EVAL_ANALYZER=rules
SPEECH_EVAL_API_BASE=
SPEECH_EVAL_API_KEY=
SPEECH_EVAL_MODEL=

